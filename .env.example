# ==============================================================================
# SHIVI (Smart Hybrid Intelligent Virtual Integration) - ENVIRONMENT CONFIG
# ==============================================================================

# Core Application Settings
APP_NAME=ShiVi Operations Core API
APP_ENV=development
PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Security & Authentication
JWT_SECRET_KEY=shivi_super_secure_jwt_secret_key_change_in_production_2026_ndma
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+asyncpg://postgres:shivi_secret@localhost:5432/shivi_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Cache & Queue Broker
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO S3-Compatible Evidence Store)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=shivi_minio_secret
S3_BUCKET_NAME=shivi-disaster-evidence
S3_REGION=ap-south-1

# AI Intelligence Gateway
AI_PROVIDER=hybrid_deterministic_fallback
OPENAI_API_KEY=
GEMINI_API_KEY=
ENABLE_AI_ADVISORY=true

# Multi-Cloud Data Lakehouse & BigQuery Federation
GCP_PROJECT_ID=shivi-disaster-analytics
GCP_REGION=asia-south1
BIGQUERY_DATASET_RAW=shivi_analytics_raw
BIGQUERY_DATASET_CURATED=shivi_analytics_curated
LAKEHOUSE_CATALOG_TYPE=biglake_iceberg
